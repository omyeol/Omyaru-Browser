<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Omyaru</AssemblyName>
    <RootNamespace>PrivacyBrowser.Desktop</RootNamespace>
    <Version>0.5.8</Version>
    <Company>Omyeol</Company>
    <Product>Omyaru Browser</Product>
    <Title>Omyaru Browser</Title>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(OmyaruGoogleClientJson)" LogicalName="Omyaru.GoogleDriveClient.json" Condition="'$(OmyaruGoogleClientJson)' != ''" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" GeneratePathProperty="true" ExcludeAssets="compile;runtime;build;buildTransitive" />
    <Reference Include="Microsoft.Web.WebView2.Core" HintPath="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll" Private="true" />
    <Reference Include="Microsoft.Web.WebView2.WinForms" HintPath="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll" Private="true" />
    <Reference Include="Microsoft.Web.WebView2.Wpf" HintPath="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Wpf.dll" Private="true" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" Link="runtimes\win-x64\native\WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireGoogleClientForRelease" BeforeTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(OmyaruGoogleClientJson)' == ''">
    <Error Text="Use scripts/Publish-Windows.ps1 so the desktop Google connection works without user setup." />
  </Target>
</Project>
